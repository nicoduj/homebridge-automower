{
  "name": "homebridge-automower",
  "version": "2.0.2",
  "author": "Nicolas Dujardin",
  "description": "Publish your automower as an homekit accessory",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node index.js && echo \"No syntax errors! (node $(node -v))\""
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicoduj/homebridge-automower.git"
  },
  "engines": {
    "homebridge": "^1.8.0 || ^2.0.0",
    "node": "^22 || ^24 || ^26"
  },
  "keywords": [
    "homebridge-plugin",
    "automower",
    "lawn mower",
    "husqvarna",
    "automower",
    "homekit"
  ],
  "dependencies": {
    "got": "^12.0.0"
  },
  "bugs": {
    "url": "https://github.com/nicoduj/homebridge-automower/issues"
  },
  "homepage": "https://github.com/nicoduj/homebridge-automower#readme",
  "devDependencies": {
    "husky": "^3.1.0",
    "prettier": "2.0.0",
    "pretty-quick": "^2.0.1"
  },
  "prettier": {
    "bracketSpacing": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 100
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/nicoduj/"
    },
    {
      "type": "paypal",
      "url": "https://www.paypal.me/nicoduj/"
    }
  ]
}
